PORT=3000
NODE_ENV=development
# Origin frontend yang diizinkan, pisahkan dengan koma. "*" hanya untuk development.
CORS_ORIGIN=*

# PostgreSQL. Tanpa Postgres/Docker lokal: `npm run db:dev` lalu salin URL "TCP" yang dicetak.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Supabase (dashboard > Connect > Direct). Ganti dua baris di atas dengan dua baris ini:
#   DATABASE_URL = Transaction pooler (port 6543), dipakai aplikasi; cocok untuk Vercel serverless.
#   DIRECT_URL   = Session pooler (port 5432), hanya dipakai `npm run db:migrate`.
# Password yang berisi karakter khusus harus di-percent-encode.
# ponytail: sslmode=require + uselibpqcompat = terenkripsi tetapi sertifikat tidak diverifikasi
# (sama seperti psql). Untuk verifikasi penuh, unduh CA Supabase dan pakai sslmode=verify-full&sslrootcert=...
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?sslmode=require&uselibpqcompat=true"
# DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# Database KHUSUS tes e2e: isinya dihapus setiap kali tes dijalankan (`npm run db:test`).
TEST_DATABASE_URL="postgres://postgres:postgres@localhost:51218/template1?sslmode=disable"

# Wajib. Buat nilai acak: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Kunci yang dikirim timbangan ESP32 pada header X-Device-Key.
IOT_DEVICE_KEY=

# Dipakai `npm run seed` untuk membuat akun admin pertama (username: admin).
SEED_ADMIN_PASSWORD=
